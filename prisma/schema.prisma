// このファイルはDB(PostgreSQL)のテーブル設計です。
// Railwayの環境変数 DATABASE_URL を読みに行きます。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// マスターデータ: 英雄
model Hero {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  troopType String // "歩兵"(盾) / "騎兵"(槍) / "弓兵"(弓) のいずれか
  generation Int? // 英雄の世代(1〜16など)
  atk       Int?
  def       Int?
  hp        Int?
  lethality Int?

  skills    HeroSkill[] // スキル(何個でも登録可能。戦闘シミュレーターの計算に使用)

  notes     String?
  createdAt DateTime @default(now())
}

// 英雄1体につき何個でも登録できるスキル(戦闘シミュレーター用)
model HeroSkill {
  id     Int  @id @default(autoincrement())
  heroId Int
  hero   Hero @relation(fields: [heroId], references: [id], onDelete: Cascade)

  name String // スキル名(自由記述、例:「決起集会」)
  skillSlot Int @default(1) // ゲーム内のスキル番号(1〜3)。集結リーダーは1〜3全部、フィラーはスキル1のみ反映される仕様に対応

  // 発動条件
  triggerType  String // "always"(常時) / "chance"(確率) / "everyNTurns"(Nターンごと) / "everyNAttacks"(N回攻撃ごと)
  triggerValue Int? // chanceなら確率(%)、everyNTurns/everyNAttacksならN

  // 効果
  target       String // "self"(自分/味方全体が対象) / "enemy"(敵全体が対象)
  stat         String // "atk" / "def" / "hp" / "lethality"
  value        Int    // パーセント(常にプラスの数値。上昇/下降はtargetで決まる)
  durationTurns Int? // 発動後、何ターン効果が持続するか(nullなら常時 or 即時)

  createdAt DateTime @default(now())
}

// マスターデータ: 専門家
model Expert {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  notes     String?
  createdAt DateTime @default(now())
}

// マスターデータ: ペット
model Pet {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  skill     String?
  notes     String?
  createdAt DateTime @default(now())
}

// 編成(自分の編成・相手の編成、どちらもこのテーブルに保存する)
model Formation {
  id        Int      @id @default(autoincrement())
  label     String? // 「対〇〇同盟用」などメモ用の名前
  side      String // "self" or "opponent"
  formationType String? // "attack" or "defense"

  shieldHeroName String? // 盾英雄(歩兵)
  spearHeroName  String? // 槍英雄(騎兵)
  bowHeroName    String? // 弓英雄(弓兵)

  expertName String?
  petName    String?

  // 兵種割合 (%)
  infantryPct Int?
  cavalryPct  Int?
  archerPct   Int?

  troopCount Int? // 兵士数

  // 領主装備(%) - 兵種ごとの攻撃力・防御力のみ(装備は攻撃力・防御力にしか効果がない)
  equipShieldAtkPct Int?
  equipShieldDefPct Int?
  equipSpearAtkPct  Int?
  equipSpearDefPct  Int?
  equipBowAtkPct    Int?
  equipBowDefPct    Int?

  // 領主宝石(%) - 兵種ごとの殺傷力・HPのみ(宝石は殺傷力・HPにしか効果がない)
  gemShieldLethalityPct Int?
  gemShieldHpPct        Int?
  gemSpearLethalityPct  Int?
  gemSpearHpPct         Int?
  gemBowLethalityPct    Int?
  gemBowHpPct           Int?

  // 装備などは後で構造化する。まずはJSON文字列で自由記述。
  equipmentNote String?

  createdAt DateTime @default(now())
}

// SVS開催回(全体の器)
model SvsRound {
  id        Int      @id @default(autoincrement())
  roundName String   // 例: "SVS 2608"
  eventDate DateTime?
  opponent  String?  // 未定の場合は空欄
  status    String?  // 例: "編成準備中" など自由入力
  result    String?  // "win" / "lose" / 未定ならnull
  createdAt DateTime @default(now())

  timeSlots    SvsTimeSlot[]
  participants SvsParticipant[]
}

// SVS開催回の中の時間帯(例: 21:00〜23:00)
model SvsTimeSlot {
  id         Int      @id @default(autoincrement())
  svsRoundId Int
  svsRound   SvsRound @relation(fields: [svsRoundId], references: [id], onDelete: Cascade)
  label      String   // 例: "21:00〜23:00"
  createdAt  DateTime @default(now())

  garrisonLeaderVbvId     Int?
  garrisonLeaderVbv       SvsParticipant? @relation("GarrisonLeaderVbv", fields: [garrisonLeaderVbvId], references: [id])
  garrisonLeaderVbvUsePet Boolean         @default(false)
  garrisonLeaderCbsId     Int?
  garrisonLeaderCbs       SvsParticipant? @relation("GarrisonLeaderCbs", fields: [garrisonLeaderCbsId], references: [id])
  garrisonLeaderCbsUsePet Boolean         @default(false)

  participantSlots SvsParticipantTimeSlot[]
  garrisonMembers  SvsGarrisonMember[]
  rallyLeaders     SvsRallyLeader[]
}

// 時間帯 と 集結リーダーに選ばれた参加者 の中間テーブル(複数人・上限なし)
model SvsRallyLeader {
  id            Int            @id @default(autoincrement())
  timeSlotId    Int
  timeSlot      SvsTimeSlot    @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  participantId Int
  participant   SvsParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  usePet        Boolean        @default(false)
}

// SVS開催回への参加者登録
model SvsParticipant {
  id             Int      @id @default(autoincrement())
  svsRoundId     Int
  svsRound       SvsRound @relation(fields: [svsRoundId], references: [id], onDelete: Cascade)
  playerName     String
  homeAlliance   String? // 所属同盟(実際に入っている同盟名・自由入力)
  alliance       String? // 参加希望同盟 "vbv" or "cbs"
  hasT12         Boolean  @default(false)
  t12ShieldSkill Int? // 盾兵スキルレベル 0〜3
  t12SpearSkill  Int? // 槍兵スキルレベル 0〜3
  t12BowSkill    Int? // 弓兵スキルレベル 0〜3
  noSleepRisk    Boolean  @default(false) // 寝落ちは考慮しないものとする
  createdAt      DateTime @default(now())

  timeSlots         SvsParticipantTimeSlot[]
  garrisonLeaderVbvFor SvsTimeSlot[] @relation("GarrisonLeaderVbv")
  garrisonLeaderCbsFor SvsTimeSlot[] @relation("GarrisonLeaderCbs")
  garrisonMemberOf  SvsGarrisonMember[]
  rallyLeaderOf     SvsRallyLeader[]
}

// 参加者 と 参加可能な時間帯 の中間テーブル(多対多)
model SvsParticipantTimeSlot {
  id            Int            @id @default(autoincrement())
  participantId Int
  participant   SvsParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  timeSlotId    Int
  timeSlot      SvsTimeSlot    @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
}

// 時間帯 と 駐屯メンバーに選ばれた参加者 の中間テーブル(最大12人を想定)
model SvsGarrisonMember {
  id            Int            @id @default(autoincrement())
  timeSlotId    Int
  timeSlot      SvsTimeSlot    @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  participantId Int
  participant   SvsParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
}

// トップページのお知らせ掲示板(誰でも書き込み・削除可能)
model Announcement {
  id         Int      @id @default(autoincrement())
  message    String
  authorName String?
  createdAt  DateTime @default(now())
}
