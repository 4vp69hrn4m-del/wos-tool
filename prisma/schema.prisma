import { NextRequest, NextResponse } from "next/server";
import { PrismaClient } from "@prisma/client";

const prisma = new PrismaClient();

// 編成保存
export async function POST(req: NextRequest) {
  try {
    const body = await req.json();

    const formation = await prisma.formation.create({
      data: {
        label: body.label || null,

        // self = 自分 / opponent = 相手
        side: body.side || "self",

        // attack / defense
        formationType: body.formationType || null,

        // 英雄
        shieldHeroName: body.shieldHeroName || body.hero1Name || null,
        spearHeroName: body.spearHeroName || body.hero2Name || null,
        bowHeroName: body.bowHeroName || body.hero3Name || null,

        // 専門家・ペット
        expertName: body.expertName || null,
        petName: body.petName || null,

        // 兵種割合
        infantryPct: body.infantryPct ?? null,
        cavalryPct: body.cavalryPct ?? null,
        archerPct: body.archerPct ?? null,

        // 装備メモ
        equipmentNote: body.equipmentNote || null,
      },
    });

    return NextResponse.json({
      success: true,
      formation,
    });

  } catch (error) {
    console.error("Formation create error:", error);

    return NextResponse.json(
      {
        success: false,
        error: "編成保存に失敗しました",
      },
      {
        status: 500,
      }
    );
  }
}


// 編成一覧取得
export async function GET() {
  try {
    const formations = await prisma.formation.findMany({
      orderBy: {
        createdAt: "desc",
      },
    });

    return NextResponse.json({
      success: true,
      formations,
    });

  } catch (error) {
    console.error("Formation fetch error:", error);

    return NextResponse.json(
      {
        success: false,
        error: "編成取得に失敗しました",
      },
      {
        status: 500,
      }
    );
  }
}