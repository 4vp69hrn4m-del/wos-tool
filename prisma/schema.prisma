// このファイルはDB(PostgreSQL)のテーブル設計です。
// Railwayの環境変数 DATABASE_URL を読みに行きます。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// マスターデータ: 英雄
model Hero {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  troopType String // "歩兵"(盾) / "騎兵"(槍) / "弓兵"(弓) のいずれか
  atk       Int?
  def       Int?
  hp        Int?
  lethality Int?

  // 主要スキル効果(計算に使う数値。最大2つまで)
  skillEffectTarget1 String? // "self"(自分の兵種が上昇) / "enemy"(敵の兵種が下降)
  skillEffectStat1   String? // "atk" / "def" / "hp" / "lethality"
  skillEffectValue1  Int?    // パーセント(常にプラスの数値。上昇/下降はtargetで決まる)
  skillEffectTarget2 String?
  skillEffectStat2   String?
  skillEffectValue2  Int?

  skills    String? // スキル名・効果の自由メモ(計算には使わない参考情報)
  notes     String?
  createdAt DateTime @default(now())
}

// マスターデータ: 専門家
model Expert {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  notes     String?
  createdAt DateTime @default(now())
}

// マスターデータ: ペット
model Pet {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  skill     String?
  notes     String?
  createdAt DateTime @default(now())
}

// 編成(自分の編成・相手の編成、どちらもこのテーブルに保存する)
model Formation {
  id        Int      @id @default(autoincrement())
  label     String? // 「対〇〇同盟用」などメモ用の名前
  side      String // "self" or "opponent"
  formationType String? // "attack" or "defense"

  shieldHeroName String? // 盾英雄(歩兵)
  spearHeroName  String? // 槍英雄(騎兵)
  bowHeroName    String? // 弓英雄(弓兵)

  expertName String?
  petName    String?

  // 兵種割合 (%)
  infantryPct Int?
  cavalryPct  Int?
  archerPct   Int?

  // 装備などは後で構造化する。まずはJSON文字列で自由記述。
  equipmentNote String?

  createdAt DateTime @default(now())
}

// SVS開催回(全体の器)
model SvsRound {
  id        Int      @id @default(autoincrement())
  roundName String   // 例: "SVS 2608"
  eventDate DateTime?
  opponent  String?  // 未定の場合は空欄
  status    String?  // 例: "編成準備中" など自由入力
  createdAt DateTime @default(now())

  timeSlots    SvsTimeSlot[]
  participants SvsParticipant[]
}

// SVS開催回の中の時間帯(例: 21:00〜23:00)
model SvsTimeSlot {
  id         Int      @id @default(autoincrement())
  svsRoundId Int
  svsRound   SvsRound @relation(fields: [svsRoundId], references: [id], onDelete: Cascade)
  label      String   // 例: "21:00〜23:00"
  createdAt  DateTime @default(now())

  rallyLeaderId        Int?
  rallyLeader          SvsParticipant? @relation("RallyLeader", fields: [rallyLeaderId], references: [id])
  rallyLeaderUsePet    Boolean         @default(false)
  garrisonLeaderId     Int?
  garrisonLeader       SvsParticipant? @relation("GarrisonLeader", fields: [garrisonLeaderId], references: [id])
  garrisonLeaderUsePet Boolean         @default(false)

  participantSlots SvsParticipantTimeSlot[]
}

// SVS開催回への参加者登録
model SvsParticipant {
  id             Int      @id @default(autoincrement())
  svsRoundId     Int
  svsRound       SvsRound @relation(fields: [svsRoundId], references: [id], onDelete: Cascade)
  playerName     String
  alliance       String? // "vbv" or "cbs"
  hasT12         Boolean  @default(false)
  t12ShieldSkill Int? // 盾兵スキルレベル 0〜3
  t12SpearSkill  Int? // 槍兵スキルレベル 0〜3
  t12BowSkill    Int? // 弓兵スキルレベル 0〜3
  noSleepRisk    Boolean  @default(false) // 寝落ちは考慮しないものとする
  createdAt      DateTime @default(now())

  timeSlots         SvsParticipantTimeSlot[]
  rallyLeaderFor    SvsTimeSlot[] @relation("RallyLeader")
  garrisonLeaderFor SvsTimeSlot[] @relation("GarrisonLeader")
}

// 参加者 と 参加可能な時間帯 の中間テーブル(多対多)
model SvsParticipantTimeSlot {
  id            Int            @id @default(autoincrement())
  participantId Int
  participant   SvsParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  timeSlotId    Int
  timeSlot      SvsTimeSlot    @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
}
