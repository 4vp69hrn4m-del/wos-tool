// このファイルはDB(PostgreSQL)のテーブル設計です。
// Railwayの環境変数 DATABASE_URL を読みに行きます。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// マスターデータ: 英雄
model Hero {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  troopType String // "歩兵"(盾) / "騎兵"(槍) / "弓兵"(弓)
  atk       Int?
  def       Int?
  hp        Int?
  lethality Int?
  notes     String?
  createdAt DateTime @default(now())
}

// マスターデータ: 専門家
model Expert {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  notes     String?
  createdAt DateTime @default(now())
}

// マスターデータ: ペット
model Pet {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  skill     String?
  notes     String?
  createdAt DateTime @default(now())
}

// 編成
model Formation {
  id        Int      @id @default(autoincrement())
  label     String?
  side      String // self or opponent
  formationType String? // attack or defense

  shieldHeroName String? // 盾英雄
  spearHeroName  String? // 槍英雄
  bowHeroName    String? // 弓英雄

  expertName String?
  petName    String?

  infantryPct Int?
  cavalryPct  Int?
  archerPct   Int?

  equipmentNote String?

  createdAt DateTime @default(now())
}