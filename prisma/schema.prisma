// このファイルはDB(PostgreSQL)のテーブル設計です。
// Railwayの環境変数 DATABASE_URL を読みに行きます。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// マスターデータ: 英雄
model Hero {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  troopType String // "歩兵"(盾) / "騎兵"(槍) / "弓兵"(弓) のいずれか
  atk       Int?
  def       Int?
  hp        Int?
  lethality Int?
  notes     String?
  createdAt DateTime @default(now())
}

// マスターデータ: 専門家
model Expert {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  notes     String?
  createdAt DateTime @default(now())
}

// マスターデータ: ペット
model Pet {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  skill     String?
  notes     String?
  createdAt DateTime @default(now())
}

// 編成(自分の編成・相手の編成、どちらもこのテーブルに保存する)
model Formation {
  id        Int      @id @default(autoincrement())
  label     String? // 「対〇〇同盟用」などメモ用の名前
  side      String // "self" or "opponent"
  formationType String? // "attack" or "defense"

  shieldHeroName String? // 盾英雄(歩兵)
  spearHeroName  String? // 槍英雄(騎兵)
  bowHeroName    String? // 弓英雄(弓兵)

  expertName String?
  petName    String?

  // 兵種割合 (%)
  infantryPct Int?
  cavalryPct  Int?
  archerPct   Int?

  // 装備などは後で構造化する。まずはJSON文字列で自由記述。
  equipmentNote String?

  createdAt DateTime @default(now())
}
